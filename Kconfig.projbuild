menu "MicroTech Project Config"
    choice BOARD_TYPE
        prompt "Development Board"
        default BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_1_8
        help
            Select the board to build for.
        config BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_1_8
            bool "Waveshare ESP32-S3-Touch-AMOLED-1.8"
            depends on IDF_TARGET_ESP32S3
            select IO_EXPANDER_ENABLE_GPIO_API_WRAPPER
            select XPOWERS_ESP_IDF_NEW_API
    endchoice

    config XPOWERS_ESP_IDF_NEW_API
        bool

    menu "Board display"
        depends on BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_1_8

        choice BSP_DISPLAY_SPI_CLOCK
            prompt "LCD SPI clock"
            default BSP_DISPLAY_SPI_CLOCK_40M
            help
                Select the requested SH8601 Quad SPI clock. Preliminary
                datasheet Table 14 specifies a minimum 50 ns write cycle,
                corresponding to a nominal 20 MHz limit. 40 MHz is the
                project empirical default, not a datasheet guarantee. 80 MHz
                is four times the nominal limit, may run on an individual
                sample, and is available only for explicit experiments; it
                can corrupt the display or freeze the GUI.

            config BSP_DISPLAY_SPI_CLOCK_40M
                bool "40 MHz (project empirical default)"

            config BSP_DISPLAY_SPI_CLOCK_80M
                bool "80 MHz (out-of-spec experimental)"
        endchoice

        config BSP_DISPLAY_SPI_CLOCK_HZ
            int
            default 40000000 if BSP_DISPLAY_SPI_CLOCK_40M
            default 80000000 if BSP_DISPLAY_SPI_CLOCK_80M

        config BSP_DISPLAY_SPI_MAX_TRANSFER_LINES
            int "Logical LCD panel transfer height"
            range 1 448
            default 10
            help
                Set the logical RGB565 panel-transfer height. On ESP32-S3, one
                32 KiB DMA transfer holds at most 44 complete 368-pixel rows
                (32,384 bytes); 45 rows require 33,120 bytes. Requests above
                44 rows remain valid and ESP-IDF splits them into DMA segments
                within the hardware limit. This setting is independent of the
                LVGL draw-buffer height.

        config BSP_DISPLAY_SPI_TRANS_QUEUE_DEPTH
            int "LCD SPI transaction queue depth"
            range 1 10
            default 2
            help
                Static panel-IO transaction capacity. Keep the production
                baseline at two unless on-board measurements justify a change.

        config BSP_DISPLAY_NON_TE_PSRAM_DMA_DIRECT
            bool "Enable direct PSRAM DMA without TE (unsafe experiment)"
            depends on SPIRAM
            default n
            help
                Allow the non-TE partial-rendering path to submit PSRAM draw
                buffers directly to SPI DMA. On the current board with
                ESP-IDF 6.0.2, a 10-row full-load run produced a blue line at
                the top of the panel and froze the GUI. Keep this disabled in
                production; the option remains only for issue reproduction or
                future driver and hardware validation.

        config BSP_DISPLAY_TE_SYNC
            bool "Enable LCD tearing-effect synchronization"
            default n
            help
                Synchronize full-frame refreshes to the SH8601 TE signal on
                GPIO13. This is disabled by default because current hardware
                validation has not observed a usable TE edge. When disabled,
                the display uses partial rendering.
    endmenu

endmenu
