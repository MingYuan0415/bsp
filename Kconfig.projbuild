menu "MicroTech Project Config"
    choice BOARD_TYPE
        prompt "Development Board"
        default BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_1_8
        help
            Select the board to build for.
        config BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_1_8
            bool "Waveshare ESP32-S3-Touch-AMOLED-1.8"
            depends on IDF_TARGET_ESP32S3
            select IO_EXPANDER_ENABLE_GPIO_API_WRAPPER
            select XPOWERS_ESP_IDF_NEW_API
    endchoice

    config XPOWERS_ESP_IDF_NEW_API
        bool

    menu "Board display"
        depends on BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_1_8

        config BSP_DISPLAY_TE_SYNC
            bool "Enable LCD tearing-effect synchronization"
            default n
            help
                Synchronize full-frame refreshes to the SH8601 TE signal on
                GPIO13. This is disabled by default because current hardware
                validation has not observed a usable TE edge. When disabled,
                the display uses partial rendering.
    endmenu

    menu "Board audio"
        config BSP_AUDIO_I2S_PORT
            int "I2S peripheral"
            range 0 1
            default 0

        config BSP_AUDIO_I2S_MCLK_GPIO
            int "I2S MCLK GPIO"
            default 16

        config BSP_AUDIO_I2S_BCLK_GPIO
            int "I2S BCLK GPIO"
            default 9

        config BSP_AUDIO_I2S_LRCK_GPIO
            int "I2S LRCK GPIO"
            default 45

        config BSP_AUDIO_I2S_DOUT_GPIO
            int "I2S data-out GPIO"
            default 8

        config BSP_AUDIO_I2S_DIN_GPIO
            int "I2S data-in GPIO"
            default 10

        config BSP_AUDIO_PA_GPIO
            int "NS4150B power-amplifier GPIO"
            range -1 48
            default 46

        config BSP_AUDIO_PA_DEFAULT_ON
            bool "Enable the power amplifier while streaming by default"
            default y

        choice BSP_AUDIO_SAMPLE_RATE
            prompt "Default sample rate"
            default BSP_AUDIO_SAMPLE_RATE_16000

            config BSP_AUDIO_SAMPLE_RATE_8000
                bool "8 kHz"
            config BSP_AUDIO_SAMPLE_RATE_11025
                bool "11.025 kHz"
            config BSP_AUDIO_SAMPLE_RATE_12000
                bool "12 kHz"
            config BSP_AUDIO_SAMPLE_RATE_16000
                bool "16 kHz"
            config BSP_AUDIO_SAMPLE_RATE_22050
                bool "22.05 kHz"
            config BSP_AUDIO_SAMPLE_RATE_24000
                bool "24 kHz"
            config BSP_AUDIO_SAMPLE_RATE_32000
                bool "32 kHz"
            config BSP_AUDIO_SAMPLE_RATE_44100
                bool "44.1 kHz"
            config BSP_AUDIO_SAMPLE_RATE_48000
                bool "48 kHz"
            config BSP_AUDIO_SAMPLE_RATE_64000
                bool "64 kHz"
            config BSP_AUDIO_SAMPLE_RATE_88200
                bool "88.2 kHz"
            config BSP_AUDIO_SAMPLE_RATE_96000
                bool "96 kHz"
        endchoice

        config BSP_AUDIO_SAMPLE_RATE_HZ
            int
            default 8000 if BSP_AUDIO_SAMPLE_RATE_8000
            default 11025 if BSP_AUDIO_SAMPLE_RATE_11025
            default 12000 if BSP_AUDIO_SAMPLE_RATE_12000
            default 16000 if BSP_AUDIO_SAMPLE_RATE_16000
            default 22050 if BSP_AUDIO_SAMPLE_RATE_22050
            default 24000 if BSP_AUDIO_SAMPLE_RATE_24000
            default 32000 if BSP_AUDIO_SAMPLE_RATE_32000
            default 44100 if BSP_AUDIO_SAMPLE_RATE_44100
            default 48000 if BSP_AUDIO_SAMPLE_RATE_48000
            default 64000 if BSP_AUDIO_SAMPLE_RATE_64000
            default 88200 if BSP_AUDIO_SAMPLE_RATE_88200
            default 96000 if BSP_AUDIO_SAMPLE_RATE_96000

        choice BSP_AUDIO_SAMPLE_WIDTH
            prompt "Default sample width"
            default BSP_AUDIO_BITS_16

            config BSP_AUDIO_BITS_16
                bool "16-bit"
            config BSP_AUDIO_BITS_24
                bool "24-bit"
                depends on BSP_AUDIO_SAMPLE_RATE_8000 || \
                           BSP_AUDIO_SAMPLE_RATE_16000 || \
                           BSP_AUDIO_SAMPLE_RATE_24000 || \
                           BSP_AUDIO_SAMPLE_RATE_32000 || \
                           BSP_AUDIO_SAMPLE_RATE_48000 || \
                           BSP_AUDIO_SAMPLE_RATE_64000 || \
                           BSP_AUDIO_SAMPLE_RATE_96000
            config BSP_AUDIO_BITS_32
                bool "32-bit"
        endchoice

        config BSP_AUDIO_BITS_PER_SAMPLE
            int
            default 16 if BSP_AUDIO_BITS_16
            default 24 if BSP_AUDIO_BITS_24
            default 32 if BSP_AUDIO_BITS_32

        choice BSP_AUDIO_CHANNEL_COUNT
            prompt "Default channel count"
            default BSP_AUDIO_CHANNELS_2

            config BSP_AUDIO_CHANNELS_1
                bool "Mono"
            config BSP_AUDIO_CHANNELS_2
                bool "Stereo"
        endchoice

        config BSP_AUDIO_CHANNELS
            int
            default 1 if BSP_AUDIO_CHANNELS_1
            default 2 if BSP_AUDIO_CHANNELS_2

        choice BSP_AUDIO_MCLK_RATIO
            prompt "Default MCLK multiple"
            default BSP_AUDIO_MCLK_384 if BSP_AUDIO_SAMPLE_RATE_8000 || \
                                                BSP_AUDIO_SAMPLE_RATE_16000 || \
                                                BSP_AUDIO_SAMPLE_RATE_32000 || \
                                                BSP_AUDIO_SAMPLE_RATE_48000
            default BSP_AUDIO_MCLK_768 if BSP_AUDIO_BITS_24 && \
                                               BSP_AUDIO_SAMPLE_RATE_24000
            default BSP_AUDIO_MCLK_192 if BSP_AUDIO_BITS_24
            default BSP_AUDIO_MCLK_128 if BSP_AUDIO_SAMPLE_RATE_88200
            default BSP_AUDIO_MCLK_256

            config BSP_AUDIO_MCLK_128
                bool "128x"
                depends on !BSP_AUDIO_BITS_24
            config BSP_AUDIO_MCLK_192
                bool "192x"
                depends on BSP_AUDIO_SAMPLE_RATE_8000 || \
                           BSP_AUDIO_SAMPLE_RATE_16000 || \
                           BSP_AUDIO_SAMPLE_RATE_32000 || \
                           BSP_AUDIO_SAMPLE_RATE_64000 || \
                           BSP_AUDIO_SAMPLE_RATE_96000
            config BSP_AUDIO_MCLK_256
                bool "256x"
                depends on !BSP_AUDIO_BITS_24 && !BSP_AUDIO_SAMPLE_RATE_88200
            config BSP_AUDIO_MCLK_384
                bool "384x"
                depends on BSP_AUDIO_SAMPLE_RATE_8000 || \
                           BSP_AUDIO_SAMPLE_RATE_16000 || \
                           BSP_AUDIO_SAMPLE_RATE_32000 || \
                           BSP_AUDIO_SAMPLE_RATE_48000
            config BSP_AUDIO_MCLK_512
                bool "512x"
                depends on !BSP_AUDIO_BITS_24 && \
                           (BSP_AUDIO_SAMPLE_RATE_8000 || \
                            BSP_AUDIO_SAMPLE_RATE_11025 || \
                            BSP_AUDIO_SAMPLE_RATE_12000 || \
                            BSP_AUDIO_SAMPLE_RATE_16000 || \
                            BSP_AUDIO_SAMPLE_RATE_22050 || \
                            BSP_AUDIO_SAMPLE_RATE_24000 || \
                            BSP_AUDIO_SAMPLE_RATE_32000)
            config BSP_AUDIO_MCLK_576
                bool "576x"
                depends on BSP_AUDIO_SAMPLE_RATE_32000
            config BSP_AUDIO_MCLK_768
                bool "768x"
                depends on BSP_AUDIO_SAMPLE_RATE_8000 || \
                           BSP_AUDIO_SAMPLE_RATE_16000 || \
                           BSP_AUDIO_SAMPLE_RATE_24000
            config BSP_AUDIO_MCLK_1024
                bool "1024x"
                depends on !BSP_AUDIO_BITS_24 && \
                           (BSP_AUDIO_SAMPLE_RATE_8000 || \
                            BSP_AUDIO_SAMPLE_RATE_11025 || \
                            BSP_AUDIO_SAMPLE_RATE_12000 || \
                            BSP_AUDIO_SAMPLE_RATE_16000)
            config BSP_AUDIO_MCLK_1152
                bool "1152x"
                depends on BSP_AUDIO_SAMPLE_RATE_16000
        endchoice

        config BSP_AUDIO_MCLK_MULTIPLE
            int
            default 128 if BSP_AUDIO_MCLK_128
            default 192 if BSP_AUDIO_MCLK_192
            default 256 if BSP_AUDIO_MCLK_256
            default 384 if BSP_AUDIO_MCLK_384
            default 512 if BSP_AUDIO_MCLK_512
            default 576 if BSP_AUDIO_MCLK_576
            default 768 if BSP_AUDIO_MCLK_768
            default 1024 if BSP_AUDIO_MCLK_1024
            default 1152 if BSP_AUDIO_MCLK_1152

        config BSP_AUDIO_VOLUME_DEFAULT
            int "Default speaker volume"
            range 0 100
            default 60

        config BSP_AUDIO_MIC_GAIN_DB
            int "Microphone input gain (dB)"
            range 0 42
            default 30
            help
                Analog ES8311 microphone gain applied whenever the full-duplex
                codec starts. The codec rounds this value down to a supported
                6 dB step.
    endmenu
endmenu
